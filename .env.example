OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Quota chung cho cả video và X/blog theo 2 free tier của OpenAI.
# gpt-5.4-mini: free tier lớn (X/blog luôn dùng; video dùng khi hết gpt-5.4).
OPENAI_FREE_DAILY_LIMIT=2500000
OPENAI_FREE_SAFE_LIMIT=2350000
# gpt-5.4: free tier nhỏ hơn, video thử trước để có chất lượng cao hơn.
OPENAI_FULL_FREE_DAILY_LIMIT=250000
OPENAI_FULL_FREE_SAFE_LIMIT=230000
OPENAI_DAILY_USAGE_OFFSET=0
OPENAI_DAILY_USAGE_OFFSET_DATE=2026-06-06
CACHE_TTL_HOURS=168
AUTH_TOKEN=
CT0=

# Video (YouTube / TikTok / Facebook Reel) analysis
# Đường dẫn tới binary yt-dlp/ffmpeg (mặc định dùng bản có sẵn trong PATH).
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Đường dẫn tới python trong venv đã cài faster-whisper.
WHISPER_PYTHON_PATH=.venv/bin/python3
# tiny/base/small/medium/large-v3. small là lựa chọn tốc độ/độ chính xác hợp lý trên CPU.
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
# Chặn video quá dài để tránh tốn thời gian tải/transcribe/phân tích.
VIDEO_MAX_DURATION_SECONDS=1200
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_SALT=change-me

# Đăng nhập Google + allowlist email (giống lin_escbase).
# Danh sách email được phép, phân tách bằng dấu phẩy. PHẢI giống hệt nhau ở 2
# biến (server dùng ALLOWED_EMAIL để chặn API, client dùng
# NEXT_PUBLIC_ALLOWED_EMAIL để hiện màn hình đăng nhập/từ chối đúng lúc).
ALLOWED_EMAIL=
NEXT_PUBLIC_ALLOWED_EMAIL=
